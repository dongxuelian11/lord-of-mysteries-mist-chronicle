{
  "version": 1,
  "providers": {
    "deepseek": {
      "endpointPolicy": "official",
      "officialEndpoint": "https://api.deepseek.com",
      "maxContextChars": 160000,
      "maxOutputTokens": 12000,
      "supportsJsonObject": true,
      "supportsJsonSchema": false,
      "supportsStreaming": true,
      "defaultConcurrency": 8,
      "highLatencyMs": 5000,
      "circuitFailureThreshold": 3,
      "cooldownMs": 30000,
      "retryableStatusCodes": [408, 429, 500, 501, 502, 503, 504, 505, 506, 507, 508, 509, 510, 511],
      "tokenizer": {
        "mode": "provider-reported",
        "charsPerToken": 2
      }
    },
    "compatible": {
      "endpointPolicy": "loopback",
      "maxContextChars": 80000,
      "maxOutputTokens": 12000,
      "supportsJsonObject": true,
      "supportsJsonSchema": false,
