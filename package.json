{
  "name": "lord-of-mysteries-mist-chronicle",
  "version": "0.1.0",
  "private": true,
  "description": "AI-driven Lord of Mysteries / LOTM fan organization management, world simulation and RAG narrative game",
  "keywords": [
    "lord-of-mysteries",
    "lotm",
    "诡秘之主",
    "mist-chronicle",
    "ai-game",
    "rag",
    "interactive-fiction",
    "world-simulation",
    "electron"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dongxuelian11/lord-of-mysteries-mist-chronicle.git"
  },
  "bugs": {
    "url": "https://github.com/dongxuelian11/lord-of-mysteries-mist-chronicle/issues"
  },
  "homepage": "https://github.com/dongxuelian11/lord-of-mysteries-mist-chronicle#readme",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "play": "node scripts/play.mjs",
    "db:generate": "drizzle-kit generate",
    "prepare:lore": "node scripts/prepare-lore.mjs",
    "rag:ingest": "node scripts/rag/ingest.mjs",
    "rag:status": "node scripts/rag/status.mjs",
    "rag:eval": "node scripts/rag/eval.mjs",
    "rag:export": "node scripts/rag/export-runtime.mjs",
    "rag:audit": "node scripts/rag/audit.mjs",
    "rag:benchmark": "node --max-old-space-size=8192 scripts/rag/benchmark.mjs",
    "rag:eval:full": "node scripts/rag/eval-full.mjs",
    "rag:longrun": "node scripts/rag/longrun.mjs",
    "rag:corpus:audit": "node scripts/rag/corpus-audit.mjs",
    "rag:coverage": "node scripts/rag/coverage.mjs",
    "rag:entities:audit": "node scripts/rag/entities-audit.mjs",
    "rag:conflicts": "node scripts/rag/conflicts.mjs",
    "rag:eval:blind": "node --max-old-space-size=8192 scripts/rag/eval-blind.mjs",
    "rag:game:verify": "node scripts/rag/game-verify.mjs",
    "rag:align:chapters": "node scripts/rag/align-chapters.mjs",
    "rag:eval:zh": "node --max-old-space-size=8192 scripts/rag/eval-zh.mjs",
    "rag:spoiler:audit": "node scripts/rag/spoiler-audit.mjs",
    "rag:spoiler:eval": "node scripts/rag/spoiler-eval.mjs",
    "rag:memory:benchmark": "node --expose-gc --max-old-space-size=8192 scripts/rag/memory-benchmark.mjs",
    "rag:memory:soak": "node --expose-gc --max-old-space-size=8192 scripts/rag/memory-soak.mjs",
    "rag:pack": "node scripts/rag/pack.mjs build",
    "rag:pack:verify": "node scripts/rag/pack.mjs verify",
    "rag:pack:install": "node scripts/rag/pack.mjs install",
    "rag:pack:status": "node scripts/rag/pack.mjs status",
    "rag:clean:install": "node scripts/rag/clean-install-test.mjs",
    "rag:seed:manifest": "node scripts/rag/build-seed-manifest.mjs",
    "rag:seed:scenarios": "node scripts/rag/seed-scenarios.mjs",
    "rag:alpha:routes": "node scripts/rag/alpha-routes.mjs",
    "electron:build": "electron-builder --win nsis",
    "predev": "node scripts/prepare-lore.mjs",
    "prebuild": "node scripts/prepare-lore.mjs",
    "prestart": "node scripts/prepare-lore.mjs",
    "electron:dev": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "js-yaml": "^5.2.3",
    "jszip": "^3.10.1",
    "lucide-react": "^1.28.0",
    "next": "16.2.6",
    "pdf-parse": "^2.4.5",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
