    "memory:eval": "node scripts/memory/eval.mjs",
    "memory:longrun": "node scripts/memory/longrun.mjs",
    "memory:benchmark": "node --expose-gc --max-old-space-size=8192 scripts/memory/benchmark.mjs",
    "memory:integration:audit": "node scripts/memory/integration-audit.mjs",
    "memory:integration:eval": "node scripts/memory/integration-eval.mjs",
    "memory:receipt:audit": "node scripts/memory/receipt-audit.mjs",
    "memory:receipt:eval": "node scripts/memory/receipt-eval.mjs",
    "memory:audience:audit": "node scripts/memory/audience-audit.mjs",
    "memory:audience:eval": "node scripts/memory/audience-eval.mjs",
    "ability:audit": "node scripts/abilities/audit.mjs",
    "ability:eval": "node scripts/abilities/eval.mjs",
    "ability:longrun": "node scripts/abilities/longrun.mjs",
    "ability:benchmark": "node --expose-gc --max-old-space-size=8192 scripts/abilities/benchmark.mjs",
