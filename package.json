    "rag:memory:soak": "node --expose-gc --max-old-space-size=8192 scripts/rag/memory-soak.mjs",
    "rag:pack": "node scripts/rag/pack.mjs build",
    "rag:pack:verify": "node scripts/rag/pack.mjs verify",
    "rag:pack:install": "node scripts/rag/pack.mjs install",
