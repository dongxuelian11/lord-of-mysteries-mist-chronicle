    "ability:generative:eval": "node scripts/ability-generation/eval.mjs",
    "ability:baseline:probes": "node scripts/ability-generation/baseline-probes.mjs",
    "fate:frequency:eval": "node scripts/fate/frequency-eval.mjs",
    "control:eval": "node scripts/control/eval.mjs",
    "control:longrun": "node scripts/control/longrun.mjs",
    "release:verify": "node scripts/release/verify-release.mjs source",
    "release:verify:seed": "node scripts/release/verify-release.mjs seed",
    "release:provenance": "node scripts/release/verify-release.mjs artifact",
    "release:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release/smoke-installer.ps1",
    "bundle:budget": "node scripts/release/check-bundle-budget.mjs",
    "preelectron:build": "npm run release:verify:seed",
    "electron:build": "electron-builder --win nsis --publish never",
    "predev": "node scripts/prepare-lore.mjs",
    "prebuild": "node scripts/prepare-lore.mjs",
    "prestart": "node scripts/prepare-lore.mjs",
    "electron:dev": "electron .",
    "predist:win": "npm run release:verify:seed",
    "dist:win": "electron-builder --win nsis --publish never"
